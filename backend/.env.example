# Copie este arquivo para .env e preencha com valores reais.
# NUNCA commite o arquivo .env de verdade.

# Usado pelo appsettings via variável de ambiente ConnectionStrings__DefaultConnection
# (alternativa a colocar a connection string em appsettings.Development.json).
# SQLite: "Data Source=orcafacil.db" cria o arquivo automaticamente na pasta
# de execução — não precisa de servidor de banco nem de Docker.
ConnectionStrings__DefaultConnection=Data Source=orcafacil.db

# Preenchido na FASE 3 (autenticação JWT) — gere uma chave aleatória de 32+
# caracteres. Exemplo de como gerar uma no terminal:
#   openssl rand -base64 32
# Em desenvolvimento local, já existe uma chave placeholder em
# appsettings.Development.json — só preencha isto se for rodar fora do
# ambiente Development (ex.: staging/produção).
Jwt__Key=
